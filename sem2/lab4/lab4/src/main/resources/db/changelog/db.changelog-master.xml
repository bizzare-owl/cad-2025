<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-app-user" author="todo-app">
        <createTable tableName="app_user">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_app_user" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(254)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_app_user_email"/>
            </column>
            <column name="password_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="002-create-tasks" author="todo-app">
        <createTable tableName="tasks">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_tasks" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="completed" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="priority" type="VARCHAR(20)" defaultValue="MEDIUM">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(100)"/>
            <column name="user_id" type="BIGINT"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="tasks" baseColumnNames="user_id"
                referencedTableName="app_user" referencedColumnNames="id"
                constraintName="fk_tasks_user"/>
        <createIndex tableName="tasks" indexName="idx_tasks_user_id">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="003-create-sub-task" author="todo-app">
        <createTable tableName="sub_task">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_sub_task" nullable="false"/>
            </column>
            <column name="description" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="completed" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="task_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="sub_task" baseColumnNames="task_id"
                referencedTableName="tasks" referencedColumnNames="id"
                constraintName="fk_sub_task_task"
                onDelete="CASCADE"/>
        <createIndex tableName="sub_task" indexName="idx_sub_task_task_id">
            <column name="task_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="004-create-login-history" author="todo-app">
        <createTable tableName="login_history">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_login_history" nullable="false"/>
            </column>
            <column name="login_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="ip_address" type="VARCHAR(45)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="login_history" baseColumnNames="user_id"
                referencedTableName="app_user" referencedColumnNames="id"
                constraintName="fk_login_history_user"
                onDelete="CASCADE"/>
        <createIndex tableName="login_history" indexName="idx_login_history_user_time">
            <column name="user_id"/>
            <column name="login_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="005-create-task-history" author="todo-app">
        <createTable tableName="task_history">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_task_history" nullable="false"/>
            </column>
            <column name="changed_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="old_state" type="VARCHAR(30)"/>
            <column name="new_state" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="task_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="task_history" baseColumnNames="task_id"
                referencedTableName="tasks" referencedColumnNames="id"
                constraintName="fk_task_history_task"
                onDelete="CASCADE"/>
        <createIndex tableName="task_history" indexName="idx_task_history_task_time">
            <column name="task_id"/>
            <column name="changed_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
